menu "NoiseBot"

    choice NB_BOARD_PROFILE
        prompt "NoiseBot board profile"
        default NB_BOARD_PROFILE_LEGACY
        help
            Selects the board profile explicitly in Kconfig/build. Legacy keeps
            the current Freenove-first mapping. Waveshare selects the target
            main-controller profile and disables the head-local HALs in this
            cut.

        config NB_BOARD_PROFILE_LEGACY
            bool "Legacy Freenove"

        config NB_BOARD_PROFILE_WAVESHARE
            bool "Waveshare main"

    endchoice

    menu "Audio"

        config NB_BOARD_HAS_AUDIO_REFERENCE
            bool "Board has clean speaker reference input"
            default n
            help
                Enable only on hardware with a real, clean speaker reference
                channel wired into the audio input path. The current NoiseBot
                board uses INMP441 + MAX98357A without that reference path.

        config NB_USE_DEVICE_AEC
            bool "Enable device-side AEC"
            default n
            depends on NB_BOARD_HAS_AUDIO_REFERENCE
            help
                Device-side AEC requires a clean output reference path from the
                speaker signal plus acoustic isolation. Keep disabled on the
                current mono-mic/no-reference hardware profile.

    endmenu

    menu "Camera"

        config NB_CAMERA_DIAG_ENABLED
            bool "Enable OV2640 camera path"
            default y
            help
                Enables the OV2640 capture path through esp_video/V4L2.

                The camera service keeps capture on demand and uses a short
                hot session to avoid repeated driver churn while preserving the
                robot's WiFi, SD and audio headroom.

    endmenu

endmenu
