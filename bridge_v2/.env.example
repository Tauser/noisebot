# bridge_v2/.env.example
# Copie para bridge_v2/.env e preencha. NUNCA commitar .env com segredos reais.
# Segredos (API keys) ficam APENAS aqui — nunca no objeto de config persistido.

# ── Transporte ──────────────────────────────────────────────────────────────
# Endereço IP do ESP32 (deixe vazio para usar UART)
NOISEBOT_HOST=
NOISEBOT_PORT=9000

# Porta UART (fallback de dev; usado se NOISEBOT_HOST vazio)
NOISEBOT_UART=

# ── LLM ─────────────────────────────────────────────────────────────────────
# Provider ativo: openai | gemini | none
NOISEBOT_LLM_PROVIDER=openai

# Modelo do provider ativo
NOISEBOT_LLM_MODEL=gpt-4o-mini

# Modo do pipeline: normal | local_only | degraded | realtime
NOISEBOT_PIPELINE_MODE=normal

# Timeout da chamada LLM (segundos)
NOISEBOT_LLM_TIMEOUT_S=10

# Máximo de tokens de saída
NOISEBOT_LLM_MAX_OUTPUT_TOKENS=140

# ── API Keys (SEGREDOS — nunca logados, nunca persistidos) ──────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── STT ─────────────────────────────────────────────────────────────────────
NOISEBOT_WHISPER_MODEL=small
NOISEBOT_WHISPER_BACKEND=faster
NOISEBOT_WHISPER_DEVICE=cpu
NOISEBOT_WHISPER_COMPUTE_TYPE=int8

# ── TTS ─────────────────────────────────────────────────────────────────────
# Caminho absoluto para o executável piper
NOISEBOT_PIPER_EXECUTABLE=piper

# Caminho absoluto para o modelo .onnx (FORA do repo)
NOISEBOT_PIPER_MODEL=

NOISEBOT_TTS_CACHE_SIZE=64

# ── Áudio ───────────────────────────────────────────────────────────────────
NOISEBOT_MIN_TRANSCRIBE_RMS=140
NOISEBOT_MIN_TRANSCRIBE_PEAK=1600
NOISEBOT_TTS_TARGET_PEAK=8000

# ── Reconexão ───────────────────────────────────────────────────────────────
NOISEBOT_RECONNECT_DELAY_S=1.0
NOISEBOT_RECONNECT_MAX_DELAY_S=30.0

# ── API de Operação (ops/) ───────────────────────────────────────────────────
NOISEBOT_OPS_PORT=8765
# Token de autenticação local (gere um com: python -c "import secrets; print(secrets.token_hex(32))")
NOISEBOT_OPS_TOKEN=

# ── Debug ────────────────────────────────────────────────────────────────────
NOISEBOT_LOG_LEVEL=INFO
NOISEBOT_DRY_RUN=false
