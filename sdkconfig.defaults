# NoiseBot — sdkconfig.defaults
# Aplicado sobre os defaults do ESP-IDF. Não editar sdkconfig diretamente.
# Para sobrescrever localmente: criar sdkconfig.defaults.local (não versionado).

# ── Target ────────────────────────────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32s3"

# ── Compilador ───────────────────────────────────────────────────────────────
# GCC ICE em esp_lcd_panel_rgb.c com -O2 no IDF 5.5. -Og resolve sem custo
# perceptível no S3 @ 240MHz.
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y

# ── CPU ───────────────────────────────────────────────────────────────────────
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# ── Flash ─────────────────────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ── Partition table ───────────────────────────────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── PSRAM (octal SPI, 8MB) ────────────────────────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# Reservar headroom de PSRAM para câmera futura (~300KB).
# Monitorar uso via heap_caps_get_free_size(MALLOC_CAP_SPIRAM) em produção.

# ── Brownout ──────────────────────────────────────────────────────────────────
CONFIG_ESP_BROWNOUT_DET=y
# Nível 0 ≈ 2.44V no rail de 3.3V — conservador. Ajustar empiricamente
# se houver resets espúrios com protoboard. Níveis: 0–7 (0=mais sensível).
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_0=y

# ── Watchdog ──────────────────────────────────────────────────────────────────
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
# Não monitorar idle tasks — o watchdog monitora as tasks críticas via código.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Panic em WDT timeout: gera coredump e reseta.
CONFIG_ESP_TASK_WDT_PANIC=y

# ── FreeRTOS ──────────────────────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# ── Log ───────────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
# Em produção, usar CONFIG_LOG_DEFAULT_LEVEL_WARN para reduzir overhead UART.

# ── NVS ───────────────────────────────────────────────────────────────────────
CONFIG_NVS_ENCRYPTION=n

# ── FATFS — Long Filename Support ────────────────────────────────────────────
# Necessário para nomes de arquivo > 8 caracteres no SD (ex: ding_notif.pcm).
# Heap: aloca buffer LFN dinamicamente (~256 bytes/op). Alternativa: LFN_STACK.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# ── USB Serial/JTAG — DESABILITADO ──────────────────────────────────────────
# O periférico USB Serial/JTAG toma posse de GPIO 19 (D-) e GPIO 20 (D+) no
# silício, independente de cabo conectado. GPIO 19 é o pino de dados WS2812
# (RMT). Com USB JTAG ativo, o RMT não consegue controlar os LEDs.
# Console está em UART0 — desabilitar USB JTAG não causa perda funcional.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# ── SPI / Display ─────────────────────────────────────────────────────────────
# LovyanGFX controla o SPI diretamente via driver de baixo nível.
# Não usar CONFIG_SPI_MASTER_IN_ISR — LovyanGFX gerencia DMA.

# ── WiFi — ATIVO desde Etapa 9.6 ─────────────────────────────────────────────
# WiFi é controlado pela inclusão do componente esp_wifi nos REQUIRES do
# CMakeLists (infra). BT permanece excluído — não há uso planejado.
# Credenciais em NVS namespace "nb_wifi" (ssid, pass, enabled).
# Sem credenciais: sistema opera offline sem erro.

# ── HTTP Server + WebSocket (Etapa 15.1) ─────────────────────────────────────
CONFIG_HTTPD_WS_SUPPORT=y

# ── OTA com rollback automático (Etapa 15.2) ──────────────────────────────────
# Rollback ativo: firmware OTA deve chamar esp_ota_mark_app_valid_cancel_rollback()
# em boot_manager_report_success() ou reverte ao factory no próximo boot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ── Stack mínimo de tasks ─────────────────────────────────────────────────────
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# ── Coredump (diagnóstico em crash) ──────────────────────────────────────────
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# ── ESP-SR (Etapa 12.6) ──────────────────────────────────────────────────────
# Modelo WakeNet9 "Hi ESP" compilado no build e empacotado na partição "model".
CONFIG_SR_WN_WN9_HIESP=y
# Modelos lidos da partição flash ("model") — requer partição data/spiffs "model".
CONFIG_MODEL_IN_FLASH=y
# Data cache 64KB e cache line 64B: recomendado pelo ESP-SR para S3.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
